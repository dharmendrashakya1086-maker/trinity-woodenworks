rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasEmail() {
      return request.auth != null && request.auth.email != null;
    }

    // ──────────── LIVE Collections (public reads) ────────────

    match /categories/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /collections/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ──────────── DRAFT Collections (admin only) ────────────

    match /categories_draft/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /products_draft/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /collections_draft/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ──────────── VERSION HISTORY (admin only) ────────────

    match /entity_versions/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ──────────── AUDIT LOG (admin only, immutable) ────────────

    match /audit_log/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ──────────── Customers ────────────

    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if hasEmail() && isOwner(customerId);
      allow update: if isOwner(customerId) || isAdmin();
      allow delete: if false;
    }

    // ──────────── Orders ────────────

    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.customer_id == request.auth.uid || isAdmin());
      allow create: if hasEmail()
        && request.resource.data.customer_id == request.auth.uid
        && request.resource.data.keys().hasAll(['items', 'total', 'shipping']);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ──────────── Custom Orders ────────────

    match /customOrders/{orderId} {
      allow read: if request.auth != null && (resource.data.customer_id == request.auth.uid || isAdmin());
      allow create: if hasEmail() && request.resource.data.customer_id == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ──────────── Carts ────────────

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ──────────── Contact Messages ────────────

    match /contactMessages/{msgId} {
      allow read: if isAdmin();
      allow create: if hasEmail()
        && request.resource.data.keys().hasAll(['name', 'email', 'message']);
      allow delete: if isAdmin();
    }

    // ──────────── Newsletter ────────────

    match /newsletter/{docId} {
      allow read: if isAdmin();
      allow create: if hasEmail();
    }

    // ──────────── Admin ────────────

    match /admin/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
