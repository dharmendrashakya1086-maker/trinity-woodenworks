rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper
    function isAdmin() {
      return exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    // ──────────── LIVE collections (public reads) ────────────

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ──────────── DRAFT collections (admin only) ────────────

    match /categories_draft/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /products_draft/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ──────────── Customers ────────────

    match /customers/{customerId} {
      allow read: if request.auth != null && (request.auth.uid == customerId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == customerId;
      allow update: if request.auth != null && (request.auth.uid == customerId || isAdmin());
      allow delete: if false;
    }

    // ──────────── Orders ────────────

    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.customer_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.auth.email != null
        && request.resource.data.customer_id == request.auth.uid
        && request.resource.data.keys().hasAll(['items', 'total', 'shipping']);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ──────────── Custom Orders ────────────

    match /customOrders/{orderId} {
      allow read: if request.auth != null && (resource.data.customer_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.auth.email != null
        && request.resource.data.customer_id == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ──────────── Carts (per-user, auth-required) ────────────

    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ──────────── Contact Messages ────────────

    match /contactMessages/{msgId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.auth.email != null
        && request.resource.data.keys().hasAll(['name', 'email', 'message']);
      allow delete: if isAdmin();
    }

    // ──────────── Newsletter ────────────

    match /newsletter/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null && request.auth.email != null;
    }

    // ──────────── Admin ────────────

    match /admin/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
